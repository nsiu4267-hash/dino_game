        /* CACTUS */

        .cactus {
            position: absolute;

            bottom: 65px;

            left: 100%;

            width: 34px;
            height: 65px;

            z-index: 5;

            background: #2e8b57;

            border: 3px solid #222;

            border-radius: 5px;
        }

        .cactus::before {
            content: "";

            position: absolute;

            width: 18px;
            height: 35px;

            left: -17px;
            top: 22px;

            background: #2e8b57;

            border: 3px solid #222;

            border-right: none;

            border-radius: 12px 0 0 12px;
        }

        .cactus::after {
            content: "";

            position: absolute;

            width: 18px;
            height: 28px;

            right: -17px;
            top: 8px;

            background: #2e8b57;

            border: 3px solid #222;

            border-left: none;

            border-radius: 0 12px 12px 0;
        }


